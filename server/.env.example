# Port the backend listens on
PORT=4000

# Path to your tokens file (each school/device gets its own token)
TOKENS_FILE=./tokens.json

# OpenAI API configuration, never expose this outside the server
OPENAI_API_KEY=replace-with-real-key
OPENAI_MODEL=gpt-4o-mini

# SQLite database path for usage analytics
SQLITE_DB_PATH=./data/usage.sqlite

# Front-end origin allowed to call the API (e.g., Chrome extension ID)
CORS_ORIGIN=*

# Optional overrides
SYSTEM_PROMPT=You are a helpful reflection coach.
MAX_RESPONSE_LENGTH=2000
MIN_RESPONSE_LENGTH=10
MAX_TOTAL_RESPONSE_CHARS=4000
MAX_REFLECTIONS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=45
